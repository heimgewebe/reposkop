{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifecycle-evidence.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "captured_at",
    "expires_at",
    "subject",
    "sources",
    "bindings",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "reposkop_lifecycle_evidence"
    },
    "captured_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "subject": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "git_common_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "canonical_checkout",
            "linked_worktree",
            "auxiliary_clone",
            "managed_repoground_source",
            "legacy_repobrief_source",
            "deployment_source",
            "grabowski_workspace",
            "grabowski_lifecycle_worktree",
            "unknown",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "authority",
          "source_ref",
          "observed_at",
          "sha256"
        ],
        "properties": {
          "authority": {
            "enum": [
              "grabowski",
              "bureau",
              "github",
              "repoground"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "pattern": "Z$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "leases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "resource_key",
              "active"
            ],
            "properties": {
              "resource_key": {
                "type": "string",
                "minLength": 1
              },
              "active": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pid",
              "active"
            ],
            "properties": {
              "pid": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "active": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "tmux": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "session",
              "active"
            ],
            "properties": {
              "session": {
                "type": "string",
                "minLength": 1
              },
              "active": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "state"
            ],
            "properties": {
              "id": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "state": {
                "enum": [
                  "OPEN",
                  "DRAFT",
                  "CLOSED",
                  "MERGED"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "unique_commits": {
          "type": "boolean"
        },
        "archive_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
